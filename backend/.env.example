# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# This single file configures BOTH backends in this folder:
#   - the Node Task Board API   (src/server.js, port 4000)
#   - the Python Meeting Bot    (meeting.py, port 8000)

# ─── LiveKit (https://cloud.livekit.io/) ──────────────────────────────────────
# The agent worker and the audio bridge MUST point at the same LiveKit, or the
# bot joins a room the agent isn't listening to.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Deepgram: speech-to-text + text-to-speech (https://console.deepgram.com/) ─
DEEPGRAM_API_KEY=

# ─── Meeting BaaS: puts the bot in the Meet/Zoom/Teams call ───────────────────
MEETING_BAAS_API_KEY=

# Public HTTPS URL fronting the Python bot (port 8000), e.g. an ngrok tunnel.
# Meeting BaaS must be able to reach this machine's websocket from the internet.
# Changes every time ngrok restarts unless you have a reserved domain.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# Where the bridge writes meeting transcripts. Relative to the working directory
# (this backend/ folder), so ../transcripts keeps them at the repo root.
# Transcripts contain real meeting speech and are gitignored.
TRANSCRIPT_DIR=../transcripts

# Browser origins allowed to call the Python bot (CORS). Comma-separated.
FRONTEND_URL=http://localhost:3000

# ─── Groq: the agent's LLM (https://console.groq.com/) ────────────────────────
GROQ_API_KEY=
LLM_PROVIDER=groq
# For a voice agent, time-to-first-token is the wait before it speaks. On Groq's
# free endpoint llama-3.3-70b is consistently ~0.2s TTFT (always warm) and high
# quality; llama-4-scout cold-starts to ~1.6s on the first/greeting call.
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
TTS_PROVIDER=deepgram

# ─── Node Task Board API ──────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the Python Meeting Bot is reachable. The Node backend POSTs the frozen
# context snapshot here when "Deploy Bot" is clicked. Unset, everything works
# except Deploy Bot, which returns a clean 503.
MEETING_BOT_URL=http://localhost:8000

# PostgreSQL. Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://user:password@localhost:5432/kuberya

# Auth. Generate a strong random secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── EmailJS: meeting invite/cancellation emails (optional) ───────────────────
# https://dashboard.emailjs.com/admin — leave blank to disable sending.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
