{
  "name": "taskboard-backend",
  "version": "1.0.0",
  "description": "Task Board v1 backend (auth, projects, tasks, board) built as independent feature modules on Express + PostgreSQL.",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
